{
  "name": "ai.secrets",
  "version": "0.2.0",
  "private": true,
  "description": "AI bridge for Secrets: supervises `opencode serve` and streams normalized chat events over HTTP+SSE to the Secrets frontend and the secrets-ai CLI.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "bin": {
    "secrets-ai": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts/install-termux.sh",
    "deploy",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/check-no-secrets.mjs",
    "test": "vitest run",
    "test:real": "OPENCODE_REAL=1 vitest run tests/e2e",
    "record-traces": "node scripts/record-traces.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
