# ai.secrets local development template: cp .env.example .env (never commit .env).
# The CLI and bridge read the process environment; load it with e.g. `set -a; . ./.env; set +a`.
# Prefer `secrets-ai auth set <openrouter|google|github|secrets>` for keys (0600 file, no shell history).

HOST=127.0.0.1
PORT=8790
# SECRETS_AI_HOME=          # config dir override (default ~/.config/secrets-ai, %APPDATA%\secrets-ai on Windows)
# SECRETS_AI_WORKSPACE=     # default: the bridge's cwd
# SECRETS_AI_URL=http://127.0.0.1:8790   # used by the CLI
# SECRETS_AI_TOKEN=         # bridge token override (default: auth file)
OPENCODE_BIN=opencode

# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GITHUB_TOKEN=
# SECRETS_API_URL=
# SECRETS_TOKEN=
