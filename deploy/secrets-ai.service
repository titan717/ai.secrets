[Unit]
Description=ai.secrets local AI bridge service
After=network.target

[Service]
Type=simple
User=secrets-ai
Group=secrets-ai
WorkingDirectory=/opt/ai.secrets
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8790
EnvironmentFile=-/etc/secrets-ai/env
ExecStart=/usr/bin/node /opt/ai.secrets/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/ai.secrets

[Install]
WantedBy=multi-user.target
