# System service for a VPS / server.
#
#   sudo useradd --system --home /var/lib/secrets-ai --shell /usr/sbin/nologin secrets-ai
#   sudo git clone https://github.com/titan717/ai.secrets /opt/ai.secrets
#   (cd /opt/ai.secrets && sudo npm i -g pnpm@9.15.9 && sudo pnpm install --frozen-lockfile && sudo pnpm build)
#   sudo npm i -g opencode-ai@1.19.6
#   sudo install -d -m 700 -o root -g root /etc/secrets-ai
#   sudo install -m 600 deploy/secrets-ai.env.example /etc/secrets-ai/secrets-ai.env   # then edit
#   sudo install -d -o secrets-ai -g secrets-ai -m 750 /srv/secrets-ai/workspace
#   sudo cp deploy/secrets-ai.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now secrets-ai
#   sudo -u secrets-ai SECRETS_AI_HOME=/var/lib/secrets-ai node /opt/ai.secrets/dist/cli/index.js auth token --show
#
# Keeps HOST=127.0.0.1: reach it through an SSH tunnel or a TLS reverse proxy (docs/RUN-MODES.md).
[Unit]
Description=ai.secrets bridge (OpenCode supervisor)
Documentation=https://github.com/titan717/ai.secrets/blob/main/docs/RUN-MODES.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secrets-ai
Group=secrets-ai
WorkingDirectory=/srv/secrets-ai/workspace
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=HOME=/var/lib/secrets-ai
Environment=SECRETS_AI_HOME=/var/lib/secrets-ai
Environment=SECRETS_AI_WORKSPACE=/srv/secrets-ai/workspace
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/secrets-ai/secrets-ai.env
ExecStart=/usr/bin/node /opt/ai.secrets/dist/cli/index.js serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=mixed

# State: /var/lib/secrets-ai (token, settings, OpenCode per-workspace data), mode 0700.
StateDirectory=secrets-ai
StateDirectoryMode=0700
UMask=0077

# Hardening. OpenCode's shell/edit tools run as this user inside these limits.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secrets-ai /srv/secrets-ai/workspace
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Not set on purpose: MemoryDenyWriteExecute (breaks V8/Bun JIT).

[Install]
WantedBy=multi-user.target
