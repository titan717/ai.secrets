# Per-user service (laptop / desktop / single-user VPS), no root needed.
#
#   scripts/install.sh   (puts the CLI shim at ~/.local/bin/secrets-ai)
#   mkdir -p ~/.config/systemd/user ~/secrets-workspace
#   cp deploy/secrets-ai.user.service ~/.config/systemd/user/secrets-ai.service
#   systemctl --user daemon-reload && systemctl --user enable --now secrets-ai
#   loginctl enable-linger "$USER"     # optional: keep running after logout
#   journalctl --user -u secrets-ai -f
#
# Change the workspace with `systemctl --user edit secrets-ai`:
#   [Service]
#   Environment=SECRETS_AI_WORKSPACE=%h/code/myproject
#   ReadWritePaths=%h/code/myproject
[Unit]
Description=ai.secrets bridge (user)
Documentation=https://github.com/titan717/ai.secrets/blob/main/docs/RUN-MODES.md
After=network-online.target

[Service]
Type=simple
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=SECRETS_AI_WORKSPACE=%h/secrets-workspace
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/secrets-ai/env
WorkingDirectory=%h/secrets-workspace
ExecStart=%h/.local/bin/secrets-ai serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077

# Hardening that works in user managers (some options need unprivileged user namespaces;
# if the unit fails to start with status=218/CAPABILITIES or 226/NAMESPACE, comment out
# ProtectSystem/ProtectHome/PrivateTmp).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/secrets-ai %h/secrets-workspace %h/.cache
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
