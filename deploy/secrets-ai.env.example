# Environment for the secrets-ai bridge (systemd EnvironmentFile or docker env_file).
#   systemd: sudo install -m 600 -o root -g root deploy/secrets-ai.env.example /etc/secrets-ai/secrets-ai.env
#   docker:  cp deploy/secrets-ai.env.example deploy/secrets-ai.env && chmod 600 deploy/secrets-ai.env
# Keep this file mode 600. Never commit the filled-in copy.
# Keys can instead be stored with `secrets-ai auth set <name>` (0600 auth file); env wins over the file.

# Bind address. Keep 127.0.0.1 on hosts; use an SSH tunnel or TLS reverse proxy for remote access.
# (The Docker image sets HOST=0.0.0.0 internally and publishes to 127.0.0.1 only.)
HOST=127.0.0.1
PORT=8790

# Directory OpenCode works in (files it may read/edit, commands run there).
SECRETS_AI_WORKSPACE=/srv/secrets-ai/workspace

# Path/command of the opencode binary.
OPENCODE_BIN=opencode

# Optional: fixed bridge token (otherwise generated into the auth file on first start).
# SECRETS_AI_TOKEN=

# Provider keys (only the ones you use).
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GITHUB_TOKEN=

# Secrets API integration (secrets-mcp).
# SECRETS_API_URL=https://api.example.com
# SECRETS_TOKEN=
